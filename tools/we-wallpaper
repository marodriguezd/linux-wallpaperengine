#!/bin/bash
# we-wallpaper (fork): helper para linux-wallpaperengine en Sway (Wayland) y X11 (DWM)
#
# Novedades del fork:
#   - backend auto: swaymsg si hay Wayland/Sway, xrandr si hay X11
#   - WE_PROFILE= lite|balanced|full -> --profile (va antes de los flags para que
#     los flags explícitos ganen, según orden de argparse)
#   - WE_FPS_BATTERY=N -> --fps-battery N (0 = pausar en batería)
#   - WE_PAUSE_ON_BATTERY=1 -> --pause-on-battery

WE_DIR="${WE_DIR:-$HOME/.local/share/Steam/steamapps/workshop/content/431960}"
ASSETS_DIR="${WE_ASSETS_DIR:-$HOME/.local/share/Steam/steamapps/common/wallpaper_engine/assets}"
# Auto-preferencia: el fork antes que el PATH. /usr/local/bin puede contener
# builds rancios que crashean al arrancar (malloc assertion) dejando el thumb
# feh estático; /opt/fork es el build verificado del fork.
if [ -n "${WE_ENGINE:-}" ]; then
    ENGINE="$WE_ENGINE"
elif [ -x /opt/fork/linux-wallpaperengine ]; then
    ENGINE=/opt/fork/linux-wallpaperengine
else
    ENGINE=linux-wallpaperengine
fi
# Cursor: se hereda del entorno salvo override (antes Banana:30 fijo).
# En dwm-titus el vivo es cat_cursors:32 vía theme-env.sh, así que heredar
# respeta tu tema en cualquier X11.
CURSOR_ENV=()
[ -n "${WE_CURSOR_THEME:-}" ] && CURSOR_ENV+=("XCURSOR_THEME=$WE_CURSOR_THEME")
[ -n "${WE_CURSOR_SIZE:-}" ] && CURSOR_ENV+=("XCURSOR_SIZE=$WE_CURSOR_SIZE")
STATE_DIR="$HOME/.config/we-wallpaper"
STATE_FILE="$STATE_DIR/state.conf"
# Fase 2: catálogo (misma ruta que Library::cachePath del engine)
CACHE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/linux-wallpaperengine/library.json"
THUMBS_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/linux-wallpaperengine/thumbs"

detect_backend() {
    if [ -n "${WE_BACKEND:-}" ]; then
	case "$WE_BACKEND" in
	    sway|x11)
		echo "$WE_BACKEND"
		return 0
		;;
	    *)
		echo "we-wallpaper: WE_BACKEND='$WE_BACKEND' no válido (usa sway|x11), autodetectando" >&2
		;;
	esac
    fi
    if command -v swaymsg >/dev/null 2>&1 && swaymsg -t get_outputs >/dev/null 2>&1; then
	echo "sway"
    elif [ -n "${DISPLAY:-}" ] && command -v xrandr >/dev/null 2>&1 \
	&& xrandr --listmonitors >/dev/null 2>&1; then
	echo "x11"
    else
	echo "unknown"
    fi
}

save_state() {
    local id="$1" mode="$2" screen="$3" apply_type="${4:-single}"
    mkdir -p "$STATE_DIR"
    cat > "$STATE_FILE" << EOF
WALLPAPER_ID=$id
MODE=$mode
SCREEN=$screen
APPLY_TYPE=$apply_type
BACKEND=$(detect_backend)
WE_PROFILE=${WE_PROFILE:-}
WE_FPS_BATTERY=${WE_FPS_BATTERY:-}
WE_PAUSE_ON_BATTERY=${WE_PAUSE_ON_BATTERY:-}
PLAYLIST_FILE=${PLAYLIST_FILE:-}
EOF
}

load_state() {
    if [ -f "$STATE_FILE" ]; then
	# shellcheck disable=SC1090
	source "$STATE_FILE"
	echo "${WALLPAPER_ID:-}|${MODE:-normal}|${SCREEN:-}|${APPLY_TYPE:-single}|${BACKEND:-}|${WE_PROFILE:-}|${WE_FPS_BATTERY:-}|${WE_PAUSE_ON_BATTERY:-}|${PLAYLIST_FILE:-}"
    fi
}

# Fase 2: ¿el engine trae catálogo (fork) o es el upstream viejo?
engine_supports_library() {
    "$ENGINE" --help 2>/dev/null | grep -qF -- "--list-library"
}

# Deja una caché válida lista: la existente, la regenerada con el fork,
# o falla para que el llamador use el scan legacy.
ensure_cache() {
    if [ -s "$CACHE_FILE" ] \
	&& python3 -c "import json; d=json.load(open('$CACHE_FILE')); assert d.get('version')==1 and isinstance(d.get('items'),list)" 2>/dev/null; then
	return 0
    fi
    if engine_supports_library && "$ENGINE" --list-library --refresh >/dev/null 2>&1 \
	&& [ -s "$CACHE_FILE" ]; then
	return 0
    fi
    return 1
}

get_refresh_rate() {
    if [ "$(detect_backend)" = "sway" ]; then
	swaymsg -t get_outputs 2>/dev/null | python3 -c "
import json,sys
outputs = json.load(sys.stdin)
if outputs:
    print(int(outputs[0]['current_mode']['refresh'] / 1000))
else:
    print(60)
" 2>/dev/null || echo 60
    else
	local rate
	rate=$(xrandr 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i ~ /\*/) {gsub (/[^0-9.]/, "", $i); split ($i, a, "."); print a[1]; exit}}')
	echo "${rate:-60}"
    fi
}

get_primary_screen() {
    if [ "$(detect_backend)" = "sway" ]; then
	swaymsg -t get_outputs 2>/dev/null | python3 -c "import json,sys; print(json.load(sys.stdin)[0]['name'])" 2>/dev/null || echo "eDP-1"
    else
	xrandr --listmonitors 2>/dev/null | awk '/\*/{print $NF; exit}' || echo "eDP-1"
    fi
}

get_all_screens() {
    if [ "$(detect_backend)" = "sway" ]; then
	swaymsg -t get_outputs 2>/dev/null | python3 -c "import json,sys; [print(o['name']) for o in json.load(sys.stdin)]" 2>/dev/null
    else
	xrandr --listmonitors 2>/dev/null | tail -n +2 | awk '{print $NF}'
    fi
}

# Flags del fork: --profile y batería van PRIMERO para que los flags
# explícitos (--disable-*, --fps) ganen por orden de argparse
fork_flags() {
    if [ -n "${WE_PROFILE:-}" ]; then
	printf '%s\n' "--profile" "$WE_PROFILE"
    fi
    if [ "${WE_PAUSE_ON_BATTERY:-}" = "1" ]; then
	printf '%s\n' "--pause-on-battery"
    elif [ -n "${WE_FPS_BATTERY:-}" ]; then
	printf '%s\n' "--fps-battery" "$WE_FPS_BATTERY"
    fi
    # vaapi en NVIDIA evita el segfault de libcuda al cambiar de video
    if [ -n "${WE_HWDEC:-}" ]; then
	printf '%s\n' "--hwdec" "$WE_HWDEC"
    fi
}

list_wallpapers() {
    echo "=== Wallpapers disponibles [backend: $(detect_backend)] ==="
    # Vía rápida Fase 2: un solo python3 sobre la caché (antes: 2 por item)
    if ensure_cache; then
	python3 -c "
import json
for it in json.load(open('$CACHE_FILE'))['items']:
    flag = '' if it.get('valid', True) else ' (invalid)'
    print('%-12s [%-5s] %s%s' % (it.get('id', '?'), it.get('type', 'unknown'), it.get('title') or it.get('id', '?'), flag))
"
	return 0
    fi
    # Legacy: engine viejo sin catálogo (lento pero funciona)
    for dir in "$WE_DIR"/*/; do
	id=$(basename "$dir")
	name=""
	type=""
	if [ -f "$dir/project.json" ]; then
	    name=$(python3 -c "import json; d=json.load(open('$dir/project.json')); print(d.get('title', 'Sin titulo'))" 2>/dev/null)
	    type=$(python3 -c "import json; d=json.load(open('$dir/project.json')); print(d.get('type', 'unknown'))" 2>/dev/null)
	fi
	printf "%-12s %-6s %s\n" "$id" "[$type]" "${name:-Sin titulo}"
    done
}

apply_wallpaper() {
    local wallpaper_id="$1"
    local mode="${2:-normal}"
    local screen="${3:-$(get_primary_screen)}"
    local fps=$(get_refresh_rate)

    if [ ! -d "$WE_DIR/$wallpaper_id" ]; then
	echo "Error: Wallpaper '$wallpaper_id' no encontrado"
	echo "Usa 'we-wallpaper list' para ver disponibles"
	return 1
    fi

    killall "$ENGINE" 2>/dev/null

    local fork_args=()
    while IFS= read -r arg; do
	[ -n "$arg" ] && fork_args+=("$arg")
    done < <(fork_flags)

    # Precedencia fps: WE_FPS explícito > fps del --profile > refresco auto.
    # (argparse aplica en orden: --profile va en fork_args antes que flags,
    # así que un --fps aquí pisaría el preset; por eso se omite con perfil)
    local flags=(--scaling fill --silent)
    if [ -n "${WE_FPS:-}" ]; then
	flags+=(--fps "$WE_FPS")
    elif [ -z "${WE_PROFILE:-}" ]; then
	flags+=(--fps "$fps")
    fi
    case "$mode" in
	lite)
	    flags+=(--disable-particles --disable-mouse --disable-parallax --no-audio-processing)
	    ;;
	no-particles)
	    flags+=(--disable-particles)
	    ;;
    esac

    # overrides por wallpaper (props/<id>.conf), solo modo fondo fijo
    load_saved_props "$wallpaper_id" flags

    # shellcheck disable=SC2086
    env "${CURSOR_ENV[@]}" nohup $ENGINE \
	--screen-root "$screen" \
	--bg "$wallpaper_id" \
	"${fork_args[@]}" \
	"${flags[@]}" \
	--assets-dir "$ASSETS_DIR" > /tmp/we.log 2>&1 &

    echo "Wallpaper $wallpaper_id en $screen @ ${fps}Hz (modo: $mode, backend: $(detect_backend))"
    save_state "$wallpaper_id" "$mode" "$screen" "single"
    apply_theme "$(theme_image_for "$wallpaper_id")"
}

apply_all() {
    local wallpaper_id="$1"
    local mode="${2:-normal}"
    local fps=$(get_refresh_rate)

    if [ ! -d "$WE_DIR/$wallpaper_id" ]; then
	echo "Error: Wallpaper '$wallpaper_id' no encontrado"
	return 1
    fi

    killall "$ENGINE" 2>/dev/null

    local fork_args=()
    while IFS= read -r arg; do
	[ -n "$arg" ] && fork_args+=("$arg")
    done < <(fork_flags)

    # Precedencia fps: WE_FPS explícito > fps del --profile > refresco auto.
    # (argparse aplica en orden: --profile va en fork_args antes que flags,
    # así que un --fps aquí pisaría el preset; por eso se omite con perfil)
    local flags=(--scaling fill --silent)
    if [ -n "${WE_FPS:-}" ]; then
	flags+=(--fps "$WE_FPS")
    elif [ -z "${WE_PROFILE:-}" ]; then
	flags+=(--fps "$fps")
    fi
    case "$mode" in
	lite)
	    flags+=(--disable-particles --disable-mouse --disable-parallax --no-audio-processing)
	    ;;
	no-particles)
	    flags+=(--disable-particles)
	    ;;
    esac

    # overrides por wallpaper (props/<id>.conf), solo modo fondo fijo
    load_saved_props "$wallpaper_id" flags

    # Un solo proceso con N pares --screen-root/--bg: evita la carrera del
    # root-pixmap de N procesos concurrentes (visible en multi-head i3/bspwm)
    local screen_args=() first_screen=""
    while IFS= read -r screen; do
	[ -z "$screen" ] && continue
	[ -z "$first_screen" ] && first_screen="$screen"
	screen_args+=(--screen-root "$screen" --bg "$wallpaper_id")
    done < <(get_all_screens)

    if [ ${#screen_args[@]} -eq 0 ]; then
	echo "Error: no se detectó ningún monitor"
	return 1
    fi

    # shellcheck disable=SC2086
    env "${CURSOR_ENV[@]}" nohup $ENGINE \
	"${screen_args[@]}" \
	"${fork_args[@]}" \
	"${flags[@]}" \
	--assets-dir "$ASSETS_DIR" > /tmp/we.log 2>&1 &

    echo "Wallpaper $wallpaper_id en todos los monitores @ ${fps}Hz (modo: $mode)"
    save_state "$wallpaper_id" "$mode" "$first_screen" "all"
    apply_theme "$(theme_image_for "$wallpaper_id")"
}

# Fase B: playlists formato propio (IDs por línea, cabeceras # delay: / # order:).
# next/prev SOLO apuntan a engines con --playlist-file en su cmdline:
# USR1/2 en un engine viejo es SIG_DFL = matar la sesión. pgrep -x no sirve
# (comm se trunca a 15 chars); el [l] evita el self-match de pgrep -f.
engine_pid() {
    local base=$(basename "$ENGINE")
    pgrep -f "[${base:0:1}]${base:1}.*--playlist-file" 2>/dev/null | head -n 1
}

playlist_play() {
    local file="$1" target="${2:-$(get_primary_screen)}"
    [ -f "$file" ] || { echo "Playlist no encontrada: $file"; return 1; }
    local fps=$(get_refresh_rate)

    killall "$ENGINE" 2>/dev/null

    local fork_args=()
    while IFS= read -r arg; do
	[ -n "$arg" ] && fork_args+=("$arg")
    done < <(fork_flags)

    local flags=(--scaling fill --silent)
    if [ -n "${WE_FPS:-}" ]; then
	flags+=(--fps "$WE_FPS")
    elif [ -z "${WE_PROFILE:-}" ]; then
	flags+=(--fps "$fps")
    fi

    # primer item para theming y estado
    local first=$(grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$file" | head -n 1 | tr -d ' \t\r')

    if [ "$target" = "all" ]; then
	local screen_args=() first_screen=""
	while IFS= read -r screen; do
	    [ -z "$screen" ] && continue
	    [ -z "$first_screen" ] && first_screen="$screen"
	    screen_args+=(--screen-root "$screen" --playlist-file "$file")
	done < <(get_all_screens)
	[ ${#screen_args[@]} -eq 0 ] && { echo "Error: no se detectó ningún monitor"; return 1; }
	# shellcheck disable=SC2086
	env "${CURSOR_ENV[@]}" nohup $ENGINE \
	    "${screen_args[@]}" \
	    "${fork_args[@]}" \
	    "${flags[@]}" \
	    --assets-dir "$ASSETS_DIR" > /tmp/we.log 2>&1 &
	echo "Playlist $file en todos los monitores (modo: timer)"
	PLAYLIST_FILE="$file" save_state "playlist" "playlist" "$first_screen" "playlist-all"
    else
	# shellcheck disable=SC2086
	env "${CURSOR_ENV[@]}" nohup $ENGINE \
	    --screen-root "$target" --playlist-file "$file" \
	    "${fork_args[@]}" \
	    "${flags[@]}" \
	    --assets-dir "$ASSETS_DIR" > /tmp/we.log 2>&1 &
	echo "Playlist $file en $target (modo: timer)"
	PLAYLIST_FILE="$file" save_state "playlist" "playlist" "$target" "playlist"
    fi

    [ -n "$first" ] && apply_theme "$(theme_image_for "$first")"
    return 0
}

playlist_next() {
    local pid=$(engine_pid)
    [ -n "$pid" ] || { echo "Sin playlist en marcha (playlist-play primero)"; return 1; }
    kill -USR1 "$pid" && echo "next ($pid)"
}

playlist_prev() {
    local pid=$(engine_pid)
    [ -n "$pid" ] || { echo "Sin playlist en marcha (playlist-play primero)"; return 1; }
    kill -USR2 "$pid" && echo "prev ($pid)"
}

stop_wallpaper() {
    killall "$ENGINE" 2>/dev/null && echo "Wallpaper detenido" || echo "No hay wallpaper activo"
}

wait_for_backend() {
    local max_attempts=30
    local attempt=0
    local backend=$(detect_backend)

    if [ "$backend" = "sway" ]; then
	[ -z "$SWAYSOCK" ] && export SWAYSOCK=$(ls -1 /run/user/"$(id -u)"/sway-ipc.*.sock 2>/dev/null | head -n 1)
	[ -z "$WAYLAND_DISPLAY" ] && export WAYLAND_DISPLAY="wayland-0"
	while [ $attempt -lt $max_attempts ]; do
	    if swaymsg -t get_outputs >/dev/null 2>&1; then
		return 0
	    fi
	    attempt=$((attempt + 1))
	    sleep 1
	done
    elif [ "$backend" = "x11" ]; then
	while [ $attempt -lt $max_attempts ]; do
	    if xrandr --listmonitors >/dev/null 2>&1; then
		return 0
	    fi
	    attempt=$((attempt + 1))
	    sleep 1
	done
    else
	echo "Error: ni Sway ni X11 detectados (¿DISPLAY/WAYLAND_DISPLAY?)"
	return 1
    fi

    echo "Error: backend no respondio tras ${max_attempts}s"
    return 1
}

is_video_wallpaper() {
    local id="$1"
    # Vía caché Fase 2 (tipos en minúsculas: scene|video|web)
    if ensure_cache 2>/dev/null; then
	local wtype
	wtype=$(python3 -c "import json; print('\n'.join(it.get('type','') for it in json.load(open('$CACHE_FILE'))['items'] if it.get('id')=='$id'))" 2>/dev/null | head -n 1)
	[ "$(echo "$wtype" | tr '[:upper:]' '[:lower:]')" = "video" ] && return 0
	return 1
    fi
    local pj="$WE_DIR/$id/project.json"
    if [ -f "$pj" ]; then
	local wtype
	wtype=$(python3 -c "import json; print(json.load(open('$pj')).get('type',''))" 2>/dev/null)
	[ "$wtype" = "video" ] && return 0
    fi
    return 1
}

restore_wallpaper() {
    local state
    state=$(load_state)
    if [ -z "$state" ] || [ "$(echo "$state" | cut -d'|' -f1)" = "" ]; then
	echo "No hay wallpaper guardado para restaurar"
	return 1
    fi

    wait_for_backend || return 1
    sleep 2

    local id mode screen apply_type saved_profile saved_fps
    id=$(echo "$state" | cut -d'|' -f1)
    mode=$(echo "$state" | cut -d'|' -f2)
    screen=$(echo "$state" | cut -d'|' -f3)
    apply_type=$(echo "$state" | cut -d'|' -f4)
    saved_profile=$(echo "$state" | cut -d'|' -f6)
    saved_fps=$(echo "$state" | cut -d'|' -f7)
    saved_pob=$(echo "$state" | cut -d'|' -f8)
    saved_pl=$(echo "$state" | cut -d'|' -f9)

    # respeta lo guardado salvo override por entorno actual
    [ -z "${WE_PROFILE:-}" ] && WE_PROFILE="$saved_profile"
    [ -z "${WE_FPS_BATTERY:-}" ] && WE_FPS_BATTERY="$saved_fps"
    [ -z "${WE_PAUSE_ON_BATTERY:-}" ] && WE_PAUSE_ON_BATTERY="$saved_pob"
    export WE_PROFILE WE_FPS_BATTERY WE_PAUSE_ON_BATTERY

    # playlists guardadas se restauran como playlist, no como fondo fijo
    if [ -n "$saved_pl" ] && [ -f "$saved_pl" ]; then
	if [ "$apply_type" = "playlist-all" ]; then
	    playlist_play "$saved_pl" "all"
	else
	    playlist_play "$saved_pl" "$screen"
	fi
	return $?
    fi

    # Warn about video wallpapers (they work via nvdec-copy despite Vulkan warnings)
    if is_video_wallpaper "$id"; then
	echo "Wallpaper '$id' es video (usa nvdec-copy — Vulkan warnings son normales)"
    fi

    if [ "$apply_type" = "all" ]; then
	apply_all "$id" "$mode"
    else
	apply_id "$id" "$mode"
    fi
}

refresh_library() {
    if engine_supports_library; then
	"$ENGINE" --list-library --refresh
    else
	echo "Engine sin --list-library: instala el fork (fase B) para regenerar la caché"
	return 1
    fi
}

# Fase 2: thumbs uniformes en $THUMBS_DIR/<id>.png
#   video -> primer frame con ffmpeg (instantáneo, fiable)
#   scene/web -> render real del engine en ventana 480x270 (necesita display)
make_previews() {
    local force=0 timeout="${WE_PREVIEW_TIMEOUT:-60}"
    [ "${1:-}" = "--force" ] && force=1
    ensure_cache || { echo "Sin caché y sin engine fork: no se puede"; return 1; }
    mkdir -p "$THUMBS_DIR"
    local done=0 skipped=0 failed=0
    # NOTE: el loop lee del FD 3 y ffmpeg/engine llevan -nostdin + </dev/null:
    # sin eso ffmpeg devora el stdin del process substitution y las líneas
    # llegan rasgadas al read (IDs truncados como 3256064096 -> 56064096).
    while IFS='|' read -r id wtype wfile wpath <&3; do
	[ -z "$id" ] && continue
	local thumb="$THUMBS_DIR/$id.png"
	if [ $force -eq 0 ] && [ -s "$thumb" ]; then
	    skipped=$((skipped + 1)); continue
	fi
	if [ "$wtype" = "video" ] && command -v ffmpeg >/dev/null 2>&1 && [ -f "$wpath/$wfile" ]; then
	    if ffmpeg -nostdin -y -loglevel error -i "$wpath/$wfile" -vframes 1 "$thumb" 2>/dev/null \
		&& [ -s "$thumb" ]; then
		done=$((done + 1)); echo "thumb: $id (ffmpeg)"
	    else
		failed=$((failed + 1)); echo "thumb FAIL: $id (ffmpeg)"
	    fi
	elif [ "$wtype" = "scene" ] || [ "$wtype" = "web" ]; then
	    "$ENGINE" "$id" --screenshot "$thumb" --screenshot-delay 45 \
		--profile lite --fps 15 -w 0x0x480x270 --silent --disable-mouse \
		--assets-dir "$ASSETS_DIR" >/dev/null 2>&1 &
	    local pid=$! waited=0
	    while [ $waited -lt "$timeout" ] && [ ! -s "$thumb" ]; do
		sleep 1; waited=$((waited + 1))
	    done
	    kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
	    if [ -s "$thumb" ]; then
		done=$((done + 1)); echo "thumb: $id (engine)"
	    else
		failed=$((failed + 1)); echo "thumb FAIL: $id (engine, ¿display?)"
	    fi
	else
	    echo "thumb SKIP: $id (tipo '$wtype' sin fuente)"
	    skipped=$((skipped + 1))
	fi
    done 3< <(python3 -c "
import json
for it in json.load(open('$CACHE_FILE'))['items']:
    print('%s|%s|%s|%s' % (it.get('id',''), it.get('type',''), it.get('file',''), it.get('path','')))
")
    echo "Previews: $done ok, $skipped saltados, $failed fallos -> $THUMBS_DIR"
}

# Fase 3: cambiador con cascada rofi -> dmenu -> fzf -> terminal.
# Lee la caché (no escanea), devuelve el id elegido por stdout en apply.
switch_wallpaper() {
    local mode="${1:-${WE_MODE:-lite}}"
    # WE_MENU=rofi|dmenu|fzf|terminal fuerza un tier (auto = cascada)
    local menu="${WE_MENU:-auto}"
    ensure_cache || { echo "Sin catálogo: ejecuta 'we-wallpaper refresh'"; return 1; }
    local entries
    entries=$(python3 -c "
import json
for it in json.load(open('$CACHE_FILE'))['items']:
    flag = ' (invalid)' if not it.get('valid', True) else ''
    print('%s [%s] %s%s' % (it.get('id','?'), it.get('type','unknown'), it.get('title') or it.get('id','?'), flag))
")
    [ -z "$entries" ] && { echo "Caché vacía"; return 1; }
    local line=""
    if { [ "$menu" = "auto" ] || [ "$menu" = "rofi" ]; } \
	&& command -v rofi >/dev/null 2>&1 && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
	line=$(echo "$entries" | rofi -dmenu -i -p "Wallpaper" 2>/dev/null)
    elif { [ "$menu" = "auto" ] || [ "$menu" = "dmenu" ]; } \
	&& command -v dmenu >/dev/null 2>&1 && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
	line=$(echo "$entries" | dmenu -i -p "Wallpaper:" 2>/dev/null)
    elif { [ "$menu" = "auto" ] || [ "$menu" = "fzf" ]; } \
	&& command -v fzf >/dev/null 2>&1; then
	line=$(echo "$entries" | fzf --prompt="Wallpaper> " --height=40% --reverse 2>/dev/null)
    else
	echo "$entries" | awk '{printf "%d) %s\n", NR, $0}'
	local total=$(echo "$entries" | wc -l) choice=""
	while :; do
	    printf "Elige [1-%d]: " "$total" >&2
	    read -r choice || return 1
	    if [ "$choice" -ge 1 ] 2>/dev/null && [ "$choice" -le "$total" ] 2>/dev/null; then
		line=$(echo "$entries" | sed -n "${choice}p")
		break
	    fi
	done
    fi
    [ -z "$line" ] && return 1
    local id=$(echo "$line" | awk '{print $1}')
    apply_id "$id" "$mode"
}

# Fase GUI-3: grid rofi con thumbs para cualquier X11.
# Sin rofi o sin display cae al switch en cascada.
grid() {
    local mode="${1:-${WE_MODE:-lite}}"
    if command -v rofi >/dev/null 2>&1 && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
	ensure_cache || { echo "Sin catálogo: ejecuta 'we-wallpaper refresh'"; return 1; }
	local picked
	picked=$(CACHE_FILE="$CACHE_FILE" THUMBS_DIR="$THUMBS_DIR" python3 -c "
import json, os
thumbs = os.environ.get('THUMBS_DIR', '')
for it in json.load(open(os.environ.get('CACHE_FILE', '')))['items']:
    tid = it.get('id', '?')
    tp = os.path.join(thumbs, tid + '.png')
    if not os.path.isfile(tp):
        pv = it.get('preview', '')
        pp = os.path.join(it.get('path', ''), pv) if pv else ''
        tp = pp if pp and os.path.isfile(pp) else ''
    label = '%s [%s] %s' % (tid, it.get('type', 'unknown'), it.get('title') or tid)
    if tp:
        print('%s\0icon\x1f%s' % (label, tp))
    else:
        print(label)
" | rofi -dmenu -i -p "Wallpaper" -show-icons 2>/dev/null | awk '{print $1}')
	[ -z "$picked" ] && return 1
	apply_wallpaper "$picked" "$mode" "$(get_primary_screen)"
	return $?
    fi
    switch_wallpaper "$mode"
}

# Fase 3: preset cuyo normbgcolor más se parece al color dominante de la imagen.
# Solo lee themes.toml (usuario o managed), no escribe nada.
pick_nearest_preset() {
    local img="$1"
    python3 - "$img" <<'EOF' 2>/dev/null
import os, sys, tomllib
img = sys.argv[1]
themes = os.path.expanduser("~/.config/dwm-titus/themes.toml")
if not os.path.isfile(themes):
    themes = os.path.expanduser("~/.local/share/dwm-titus/config/themes.toml")
try:
    data = tomllib.load(open(themes, "rb"))
except Exception:
    sys.exit(1)
from PIL import Image
small = Image.open(img).convert("RGB").resize((64, 64))
px = list(small.getdata())
dom = tuple(sum(c) // len(px) for c in zip(*px))


def dist(a, b):
    return sum((x - y) ** 2 for x, y in zip(a, b))


best, best_d = None, None
# [theme.nombre] anida bajo la clave "theme" en TOML
presets = data.get("theme", data) if isinstance(data, dict) else {}
for name, preset in presets.items():
    if not isinstance(preset, dict) or "normbgcolor" not in preset:
        continue
    try:
        h = preset["normbgcolor"].lstrip("#")
        rgb = (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16))
    except Exception:
        continue
    d = dist(dom, rgb)
    if best_d is None or d < best_d:
        best, best_d = name, d
if best is None:
    sys.exit(1)
print(best)
EOF
}

# Fase 3: theming estilo dwm-titus con fallbacks (nunca rompe el apply):
#   1) registra el fondo en dwm-titus si existe (fallback estático tras el engine)
#   2) WE_THEME=<preset> o auto (preset más cercano por PIL) vía dwm-settings-theme
#   quickshell recarga solo vía FileView: sin restart, sin pywal.
apply_theme() {
    local img="$1"
    [ "${WE_THEME_ENABLED:-1}" = "0" ] && return 0
    if [ "${WE_WALLPAPER_REGISTER:-1}" != "0" ] \
	&& command -v dwm-settings-wallpaper >/dev/null 2>&1 && [ -f "$img" ]; then
	dwm-settings-wallpaper apply "$img" fill >/dev/null 2>&1 || true
    fi
    local theme="${WE_THEME:-}"
    if [ "$theme" = "auto" ]; then
	theme=$(pick_nearest_preset "$img" 2>/dev/null) || theme=""
	[ -n "$theme" ] && echo "Tema auto: $theme"
    fi
    if [ -n "$theme" ] && [ "$theme" != "auto" ] \
	&& command -v dwm-settings-theme >/dev/null 2>&1; then
	dwm-settings-theme apply "$theme" >/dev/null 2>&1 || true
    fi
    return 0
}


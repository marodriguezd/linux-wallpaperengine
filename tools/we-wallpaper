case "${1:-}" in
    list)       list_wallpapers ;;
    fav)
	[ -n "${2:-}" ] || { echo "Uso: we-wallpaper fav <id>"; exit 1; }
	if engine_supports_library && [ -z "${WE_NO_FORK:-}" ]; then
	    "$ENGINE" --fav "$2"
	else
	    # fallback sin engine fork: sidecar directo
	    FAV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/we-wallpaper/favorites.json"
	    ID="$2" FAV_FILE="$FAV_FILE" python3 -c "
import json, os
fp = os.environ['FAV_FILE']
fav = set()
if os.path.isfile(fp):
    try:
        fav = set(json.load(open(fp)).get('favorites', []))
    except Exception:
        pass
iid = os.environ['ID']
if iid in fav:
    fav.discard(iid); print(iid + ': unfavorited')
else:
    fav.add(iid); print(iid + ': favorited')
os.makedirs(os.path.dirname(fp), exist_ok=True)
json.dump({'favorites': sorted(fav)}, open(fp, 'w'))
"
	fi
	;;
    tags)
	[ -n "${2:-}" ] || { echo "Uso: we-wallpaper tags <id> [tag ...]"; exit 1; }
	[ -d "$WE_DIR/$2" ] || { echo "Wallpaper '$2' no encontrado"; exit 1; }
	had_tags=""
	[ -n "${3:-}" ] && had_tags=1
	PJ="$WE_DIR/$2/project.json" python3 - "$2" "$@" <<'EOF'
import json, os, sys
# argv: [- , id, <cmd args...>] -> tags reales desde argv[4:]
pj = os.environ['PJ']
iid, newtags = sys.argv[1], sys.argv[4:]
d = json.load(open(pj))
if not newtags:
    print(' '.join(d.get('tags', [])) or '(sin tags)')
else:
    d['tags'] = newtags
    json.dump(d, open(pj, 'w'), indent=1, ensure_ascii=False)
    print(iid + ': tags = ' + ' '.join(newtags))
EOF
	[ -n "$had_tags" ] && engine_supports_library \
	    && "$ENGINE" --list-library --refresh >/dev/null 2>&1 || true
	;;
    props)      props "$2" "${@:3}" ;;
    props-clear) props_clear "$2" ;;
    gallery-json) gallery_json ;;
    apply-id)   apply_id "$2" "$3" ;;
    fetch)      fetch_url "$2" "$3" ;;
    catalog)    catalog "$2" "$3" "$4" ;;
    catalog-get) catalog_get "$2" "$3" ;;
    import)     import_video "$2" "$3" "$4" "$5" ;;
    switch)     switch_wallpaper "$2" ;;
    grid)       grid "$2" ;;
    refresh)    refresh_library ;;
    make-previews) make_previews "$2" ;;
    apply)      apply_wallpaper "$2" "$3" "$4" ;;
    apply-all)  apply_all "$2" "$3" ;;
    playlist-play) playlist_play "$2" "$3" ;;
    playlist-next) playlist_next ;;
    playlist-prev) playlist_prev ;;
    restore)    restore_wallpaper ;;
    stop)       stop_wallpaper ;;
    status)     status ;;
    current-id) current_id ;;
    *)          usage ;;
esac

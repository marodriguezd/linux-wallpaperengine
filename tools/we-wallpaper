# catalog-get <ref> [id]: resuelve la ref a URL directa y reutiliza fetch.
catalog_get() {
    local ref="${1:-}" id="${2:-}"
    [ -n "$ref" ] || { echo "Uso: we-wallpaper catalog-get <ref> [id]"; return 1; }
    local src="${ref%%:*}" key="${ref#*:}"
    case "$src" in
	bing)
	    local url="https://www.bing.com/HPImageArchive.aspx?format=js&idx=0&n=8"
	    local url2="https://www.bing.com/HPImageArchive.aspx?format=js&idx=8&n=8"
	    local file
	    file=$( (curl -fsSL -m 25 "$url" 2>/dev/null; curl -fsSL -m 25 "$url2" 2>/dev/null) | python3 -c "
import json, sys
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        data = json.loads(line)
    except Exception:
        continue
    for img in data.get('images', []):
        if img.get('startdate', '') == '$key':
            print('https://www.bing.com' + img.get('urlbase', '') + '_UHD.jpg')
            raise SystemExit
")
	    if [ -z "$file" ]; then
		# Fallback: archivo histórico cacheado (refs viejas).
		local af="${XDG_CACHE_HOME:-$HOME/.cache}/we-wallpaper/online/bing_archive.json"
		if [ -f "$af" ]; then
		    file=$(MB_KEY="$key" MB_AF="$af" python3 -c "
import json, os
try:
    data = json.load(open(os.environ['MB_AF']))
except Exception:
    raise SystemExit
for img in data.get('data', []):
    if img.get('startdate', '') == os.environ.get('MB_KEY', ''):
        print('https://www.bing.com' + img.get('urlbase', '') + '_UHD.jpg')
        break
" 2>/dev/null)
		fi
	    fi
	    [ -n "$file" ] || { echo "No encontrado en Bing: $key (prueba 'catalog bing archive')"; return 1; }
	    fetch_url "$file" "${id:-bing-$key}"
	    ;;
	wallhaven)
	    local detail
	    detail=$(curl -fsSL -m 25 "https://wallhaven.cc/api/v1/w/$key" 2>/dev/null \
		| python3 -c "
import json, sys
d = json.load(sys.stdin).get('data', {})
print(d.get('path', ''))
" 2>/dev/null)
	    [ -n "$detail" ] || { echo "Wallhaven sin file directo: $key"; return 1; }
	    fetch_url "$detail" "$id"
	    ;;
	motionbgs)
	    # catalog-get motionbgs:<id> [hd|4k|<id-custom>]: mp4 directo.
	    local q="hd" wid="motionbgs-$key-hd"
	    if [ "${2:-}" = "4k" ]; then
		q="4k"; wid="motionbgs-$key-4k"
	    elif [ -n "${2:-}" ]; then
		wid="$2"
	    fi
	    [ -d "$WE_DIR/$wid" ] && { echo "Ya existe: $wid (usa otro id)"; return 1; }
	    WE_FETCH_UA="Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0" \
	    WE_FETCH_REFERER="https://motionbgs.com/" \
	    WE_FETCH_EXT="mp4" \
	    WE_FETCH_NAME="motionbgs-$key.mp4" \
		fetch_url "https://motionbgs.com/dl/$q/$key/" "$wid"
	    ;;
	minimal)
	    # La URL es determinista: images/<nombre> en el repo DenverCoder1.
	    fetch_url "https://raw.githubusercontent.com/DenverCoder1/minimalistic-wallpaper-collection/main/images/$key" "$id"
	    ;;
	*)
	    echo "Ref desconocida: $ref (bing:FECHA | wallhaven:ID)"
	    return 1
	    ;;
    esac
}

PROPS_DIR="$HOME/.config/we-wallpaper/props"

# Fase GUI-2: props <id> [name=value ...]. Sin args lista propiedades
# (engine --list-properties) como TSV name|type|text|value|saved[*];
# con args guarda overrides en props/<id>.conf (auto-cargados al aplicar).
props() {
    local id="$1"; shift
    [ -n "$id" ] || { echo "Uso: we-wallpaper props <id> [name=value ...]"; return 1; }
    case "$id" in
	img-*) return 0 ;;  # imágenes estáticas: sin propiedades
    esac
    [ -d "$WE_DIR/$id" ] || { echo "Wallpaper '$id' no encontrado"; return 1; }
    local saved="$PROPS_DIR/$id.conf"
    if [ $# -eq 0 ]; then
	SAVED="$saved" "$ENGINE" --list-properties "$id" --assets-dir "$ASSETS_DIR" 2>/dev/null \
	    | python3 -c "
import json, os, sys
saved = {}
sp = os.environ.get('SAVED', '')
if sp and os.path.isfile(sp):
    for line in open(sp):
        line = line.strip()
        if not line or line.startswith('#') or '=' not in line:
            continue
        k, v = line.split('=', 1)
        saved[k.strip()] = v.strip()
name = typ = text = value = None
def flush():
    if name is None:
        return
    v = saved.get(name, value or '')
    mark = '*' if name in saved else ''
    print('%s\t%s\t%s\t%s\t%s' % (name, typ or 'unknown', text or name, v, mark))
for line in sys.stdin:
    line = line.rstrip('\n')
    if line and not line.startswith((' ', '\t')) and ' - ' in line:
        flush()
        name, typ = [s.strip() for s in line.split(' - ', 1)]
        text = value = None
    elif line.strip().startswith('Text:'):
        text = line.split('Text:', 1)[1].strip()
    elif line.strip().startswith('Value:'):
        value = line.split('Value:', 1)[1].strip()
flush()
"
	return 0
    fi
    mkdir -p "$PROPS_DIR" || return 1
    [ -f "$saved" ] || printf '# overrides de %s (auto-cargados al aplicar)\n' "$id" > "$saved"
    local kv k v
    for kv in "$@"; do
	[[ "$kv" == *"="* ]] || { echo "Ignorado (falta =): $kv"; continue; }
	k="${kv%%=*}"; v="${kv#*=}"
	[ -n "$k" ] || continue
	if grep -q "^${k}=" "$saved" 2>/dev/null; then
	    sed -i "s|^${k}=.*|${k}=${v}|" "$saved"
	else
	    printf '%s=%s\n' "$k" "$v" >> "$saved"
	fi
	echo "saved: $k=$v"
    done
}

props_clear() {
    local id="$1"
    [ -n "$id" ] || { echo "Uso: we-wallpaper props-clear <id>"; return 1; }
    rm -f "$PROPS_DIR/$id.conf" && echo "props de $id borrados"
}

# Flags --set-property desde props/<id>.conf (modo array nameref).
load_saved_props() {
    local id="$1" arr="$2"
    local file="$PROPS_DIR/$id.conf" k v
    [ -f "$file" ] || return 0
    local -n out="$arr"
    while IFS= read -r line || [ -n "$line" ]; do
	line="${line%$'\r'}"
	[[ "$line" =~ ^[[:space:]]*#.*$ || "$line" != *"="* ]] && continue
	k="${line%%=*}"; v="${line#*=}"
	k="${k//[[:space:]]/}"
	[ -n "$k" ] || continue
	out+=(--set-property "$k=$v")
    done < "$file"
}

# Fase GUI-1: vuelca la caché a JSON plano para la galería quickshell.
# [{id,title,type,valid,thumb}] con thumb = thumbs/<id>.png o preview.
gallery_json() {
    local out="${GALLERY_JSON:-$HOME/.config/dwm-titus/gallery-library.json}"
    ensure_cache || { echo "Sin catálogo: ejecuta 'we-wallpaper refresh'"; return 1; }
    mkdir -p "$(dirname "$out")" || return 1
    CACHE_FILE="$CACHE_FILE" THUMBS_DIR="$THUMBS_DIR" OUT="$out" python3 -c "
import json, os
def hum(n):
    for u in ('B', 'KB', 'MB', 'GB'):
        if n < 1024 or u == 'GB':
            return ('%d %s' % (n, u)) if u == 'B' else ('%.1f %s' % (n, u))
        n /= 1024.0
def fsize(p):
    try:
        if os.path.isfile(p):
            return os.path.getsize(p)
        if os.path.isdir(p):
            tot = 0
            for f in os.listdir(p):
                fp = os.path.join(p, f)
                if os.path.isfile(fp) and not f.endswith('.json'):
                    s = os.path.getsize(fp)
                    tot = max(tot, s)
            return tot
    except OSError:
        pass
    return 0
cache = json.load(open(os.environ['CACHE_FILE']))
thumbs = os.environ['THUMBS_DIR']
items = []
for it in cache.get('items', []):
    tid = it.get('id', '')
    tp = os.path.join(thumbs, tid + '.png')
    if not os.path.isfile(tp):
        pv, pp = it.get('preview', ''), ''
        if pv:
            pp = os.path.join(it.get('path', ''), pv)
        tp = pp if pp and os.path.isfile(pp) else ''
    items.append({
        'id': tid,
        'title': it.get('title') or tid,
        'type': it.get('type', 'unknown'),
        'valid': bool(it.get('valid', True)),
        'favorite': bool(it.get('favorite', False)),
        'description': it.get('description', ''),
        'tags': it.get('tags', []),
        'path': it.get('path', ''),
        'thumb': tp,
        'size_h': hum(fsize(it.get('path', ''))),
    })
lab = os.path.join(os.path.expanduser('~'), 'Pictures', 'backgrounds-lab')
if os.path.isdir(lab):
    for f in sorted(os.listdir(lab)):
        if f.lower().endswith(('.jpg', '.jpeg', '.png', '.webp', '.bmp')):
            stem = os.path.splitext(f)[0]
            fp = os.path.join(lab, f)
            items.append({
                'id': 'img-' + stem,
                'title': stem,
                'type': 'image',
                'valid': True,
                'favorite': False,
                'description': 'static image (feh)',
                'tags': ['static'],
                'path': fp,
                'thumb': fp,
            })
json.dump({'version': 1, 'items': items}, open(os.environ['OUT'], 'w'), indent=1, ensure_ascii=False)
print('gallery: %d items -> %s' % (len(items), os.environ['OUT']))
"
}

# Store: imágenes estáticas (bing/wallhaven) via feh. El engine se para.
apply_image() {
    local id="${1:-}" screen="${2:-$(get_primary_screen)}"
    local stem="${id#img-}" lab="$HOME/Pictures/backgrounds-lab" file=""
    local e
    for e in jpg jpeg png webp bmp JPG JPEG PNG WEBP; do
	[ -f "$lab/$stem.$e" ] && file="$lab/$stem.$e" && break
    done
    [ -n "$file" ] || { echo "Imagen '$id' no encontrada en backgrounds-lab"; return 1; }
    killall "$ENGINE" 2>/dev/null
    feh --bg-fill "$file" 2>/dev/null || { echo "feh falló"; return 1; }
    echo "Imagen $id en $screen (feh estático)"
    save_state "$id" "lite" "$screen" "image"
    apply_theme "$file"
}

# Fase GUI-1: alias fino para clicks (modo via $2 o WE_MODE).
apply_id() {
    [ -n "${1:-}" ] || { echo "Uso: we-wallpaper apply-id <id> [modo]"; return 1; }
    case "$1" in
	img-*) apply_image "$1" "$(get_primary_screen)" ;;
	*) apply_wallpaper "$1" "${2:-${WE_MODE:-lite}}" "$(get_primary_screen)" ;;
    esac
}

# Fase GUI-super: validación fuerte de vídeo (códec + dimensiones reales).
# Sin ffprobe no se puede validar y se acepta (avisa por stderr).
validate_video() {
    local f="$1"
    command -v ffprobe >/dev/null 2>&1 || { echo "sin ffprobe: sin validar" >&2; return 0; }
    local info
    info=$(ffprobe -v error -select_streams v:0 \
	-show_entries stream=codec_name,width,height -of csv=p=0 "$f" 2>/dev/null | head -n 1)
    [ -z "$info" ] && return 1
    echo "$info" | grep -qE "^[a-z0-9_]+,[0-9]+,[0-9]+$" || return 1
    return 0
}

# Registra un fichero de vídeo ya presente en $dir como wallpaper:
# project.json + refresh de caché. Devuelve 1 y limpia si no valida.
register_video_file() {
    local dir="$1" id="$2" file="$3" desc="$4"
    if ! validate_video "$dir/$file"; then
	rm -rf "$dir"; echo "No es un video válido"; return 1
    fi
    ID="$id" FILE="$file" DESC="$desc" DIR="$dir" python3 -c "
import json, os
json.dump({
    'title': os.environ['ID'],
    'type': 'video',
    'file': os.environ['FILE'],
    'description': os.environ.get('DESC', ''),
}, open(os.path.join(os.environ['DIR'], 'project.json'), 'w'), indent=1)
print()
"
    echo "Video listo: $id"
    if engine_supports_library; then
	"$ENGINE" --list-library --refresh >/dev/null 2>&1 || true
	echo "Caché actualizada"
    fi
}

# Fase GUI-super: import <video-local> [id] [--title "..."].
# Copia a WE_DIR como ciudadano de primera (igual que fetch).
import_video() {
    local src="$1"; shift
    local want_id="${1:-}"; [[ "${want_id:-}" == --* ]] && want_id=""
    local title=""
    while [ $# -gt 0 ]; do
	case "$1" in
	    --title) title="${2:-}"; shift 2 ;;
	    --*) echo "Opción desconocida: $1"; return 1 ;;
	    *) shift ;;
	esac
    done
    [ -n "$src" ] || { echo "Uso: we-wallpaper import <video-local> [id] [--title ...]"; return 1; }
    [ -f "$src" ] || { echo "No existe: $src"; return 1; }
    local base=$(basename "$src")
    local ext=$(echo "${base##*.}" | tr '[:upper:]' '[:lower:]')
    case "$ext" in
	mp4|webm|m4v|mov) ;;
	*) echo "Extensión no soportada: .$ext (mp4/webm/m4v/mov)"; return 1 ;;
    esac
    local id="$want_id"
    [ -z "$id" ] && id=$(echo "${base%.*}" | tr -c '[:alnum:]_-' '_' | sed 's/__*/_/g; s/^_//; s/_$//')
    [ -z "$id" ] && id="import-$(date +%s)"
    [ -n "$title" ] || title="$id"
    local dir="$WE_DIR/$id"
    [ -e "$dir" ] && { echo "Ya existe: $id (usa otro id)"; return 1; }
    mkdir -p "$dir" || return 1
    cp -- "$src" "$dir/$base" || { rm -rf "$dir"; echo "Copia fallida"; return 1; }
    # project.json con título custom si se pidió
    ID="$id" FILE="$base" DESC="imported $base" DIR="$dir" TITLE="$title" python3 -c "
import json, os
json.dump({
    'title': os.environ.get('TITLE') or os.environ['ID'],
    'type': 'video',
    'file': os.environ['FILE'],
    'description': os.environ.get('DESC', ''),
}, open(os.path.join(os.environ['DIR'], 'project.json'), 'w'), indent=1)
print()
" || { rm -rf "$dir"; return 1; }
    validate_video "$dir/$base" || { rm -rf "$dir"; echo "No es un video válido"; return 1; }
    echo "Video listo: $id"
    if engine_supports_library; then
	"$ENGINE" --list-library --refresh >/dev/null 2>&1 || true
	echo "Caché actualizada"
    fi
}

# Fase MPRIS-plan: fetch <url> [id]. Video (mp4/webm/mov/m4v) -> carpeta
# workshop con project.json + refresh de caché; imagen -> backgrounds-lab
# para feh (el engine solo representa video/scene/web, no estáticos sueltos).
fetch_url() {
    local url="$1" want_id="${2:-}"
    [ -z "$url" ] && { echo "Uso: we-wallpaper fetch <url> [id]"; return 1; }
    # Overrides para hosts quisquillosos (motionbgs): WE_FETCH_UA,
    # WE_FETCH_REFERER, WE_FETCH_EXT, WE_FETCH_NAME.
    local use_curl=0
    command -v curl >/dev/null 2>&1 && use_curl=1
    if [ "$use_curl" = 0 ]; then
	command -v wget >/dev/null 2>&1 || { echo "Ni curl ni wget disponibles"; return 1; }
    fi

    local base=$(basename "${url%%\?*}")
    [ -n "${WE_FETCH_NAME:-}" ] && base="$WE_FETCH_NAME"

    # URLs estilo Bing (/th?id=NOMBRE.EXT&...): el basename del path no sirve
    if [[ "$base" != *.* ]]; then
	base=$(echo "$url" | grep -oE '[?&]id=[^&]*' | head -n 1 | cut -d= -f2)
	[ -z "$base" ] && base="download"
    fi

    local ext=$(echo "${base##*.}" | tr '[:upper:]' '[:lower:]')
    [ -n "${WE_FETCH_EXT:-}" ] && ext="$WE_FETCH_EXT"
    local id="$want_id"
    [ -z "$id" ] && id=$(echo "${base%.*}" | tr -c '[:alnum:]_-' '_' | sed 's/__*/_/g; s/^_//; s/_$//')
    [ -z "$id" ] && id="fetch-$(date +%s)"

    # Descarga con curl (array: UA/referer con espacios a salvo) o wget.
    dl_run() { # $1=dest $2=url
	if [ "$use_curl" = 1 ]; then
	    local -a dl=(curl -fSL --retry 2)
	    [ -n "${WE_FETCH_UA:-}" ] && dl+=(--user-agent "$WE_FETCH_UA")
	    [ -n "${WE_FETCH_REFERER:-}" ] && dl+=(--referer "$WE_FETCH_REFERER")
	    [ -n "${WE_FETCH_PROGRESS:-}" ] && dl+=(--progress-bar)
	    "${dl[@]}" -o "$1" "$2"
	else
	    wget -O "$1" "$2"
	fi
    }

    case "$ext" in
	mp4|webm|m4v|mov)
	    local dir="$WE_DIR/$id" file="$base"
	    [ -d "$dir" ] && { echo "Ya existe: $id (usa otro id)"; return 1; }
	    mkdir -p "$dir" || return 1
	    if ! dl_run "$dir/$file" "$url"; then
		rm -rf "$dir"; echo "Descarga fallida"; return 1
	    fi
	    register_video_file "$dir" "$id" "$file" "fetched $url" || return 1
	    ;;
	jpg|jpeg|png|webp|bmp)
	    local lab="$HOME/Pictures/backgrounds-lab"
	    mkdir -p "$lab" || return 1
	    local dest="$lab/$id.$ext"
	    [ -f "$dest" ] && { echo "Ya existe: $dest"; return 1; }
	    dl_run "$dest" "$url" || { echo "Descarga fallida"; return 1; }
	    echo "Imagen en $dest (feh --bg-fill $dest)"
	    ;;
	*)
	    echo "Extensión no soportada: .$ext (video: mp4/webm/m4v/mov; imagen: jpg/png/webp/bmp)"
	    return 1
	    ;;
    esac
}

